{
  "name": "ts-vision",
  "description": "泰山识图 Ts-vision - 让 DSH 纯文本模型也能识图:GLM 视觉识别 + 所选模型推理(已适配 DSH 桌面客户端,重启永久生效)",
  "version": "1.0.2",
  "private": true,
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "install-desktop.ps1"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "ts-vision",
    "vision",
    "image-recognition",
    "zhipu",
    "glm",
    "免费识图"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*": "./locale/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT"
}
